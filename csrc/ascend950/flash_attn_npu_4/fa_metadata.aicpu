#include "aicpu_api.h"
#include "fa_metadata_args.h"
#include "tilingdata.h"

#include <cstdint>
#include <cstring>

namespace {
constexpr uint32_t Q_TILE_CEIL = 128;
constexpr uint32_t N_SPLIT_HELPER = 2;
constexpr uint32_t BASE_KV_SIZE = 128;
constexpr uint32_t MAX_FD_CORES = 32;
constexpr uint32_t MAX_FD_COMBINE_TASKS = 32;
constexpr uint32_t MAX_FD_BASE_TASKS = 32;
constexpr uint32_t MAX_FD_CANDIDATES = 1024;
constexpr uint64_t FD_WORKSPACE_ALIGNMENT = 512;
constexpr uint32_t SIZE_OF_16BIT = 2;
constexpr uint32_t SIZE_OF_32BIT = 4;

struct FdBaseTask {
    uint32_t kvTiles;
    uint32_t rowNum;
};

struct FdCandidate {
    uint32_t baseTask;
    uint32_t kvBegin;
    uint32_t kvEnd;
    uint64_t cost;
};

inline uint32_t CeilDiv(uint32_t numerator, uint32_t denominator)
{
    return denominator == 0 ? 0 : (numerator + denominator - 1) / denominator;
}

inline uint64_t AlignUp(uint64_t value, uint64_t alignment)
{
    return alignment == 0 ? value : ((value + alignment - 1) / alignment) * alignment;
}

inline uint32_t GetQNBlockTile(uint32_t qSeqlen, uint32_t groupSize, uint32_t embeddingSizeV)
{
    uint32_t qnBlockTile = qSeqlen == 0 ? Q_TILE_CEIL : (Q_TILE_CEIL / qSeqlen) / N_SPLIT_HELPER * N_SPLIT_HELPER;
    if (embeddingSizeV > 128 && qSeqlen != 0) {
        uint32_t maxQnBlockTile = Q_TILE_CEIL / 2 / qSeqlen;
        maxQnBlockTile = maxQnBlockTile == 0 ? 1 : maxQnBlockTile;
        qnBlockTile = qnBlockTile < maxQnBlockTile ? qnBlockTile : maxQnBlockTile;
    }
    qnBlockTile = qnBlockTile < groupSize ? qnBlockTile : groupSize;
    if (qnBlockTile > N_SPLIT_HELPER) {
        qnBlockTile = qnBlockTile / N_SPLIT_HELPER * N_SPLIT_HELPER;
    }
    return qnBlockTile == 0 ? 1 : qnBlockTile;
}

inline void DisableFlashDecode(FAInferTilingData* tilingData)
{
    tilingData->flashDecodeFlag = 0;
    tilingData->fdActiveCoreNum = 0;
    tilingData->fdCombineTaskNum = 0;
    tilingData->fdPartialTaskNum = 0;
    tilingData->fdPartialCapacity = 0;
    tilingData->fdRowCapacity = 0;
    tilingData->fdLseSubStride = 0;
    tilingData->fdCombineBlockDim = 0;
    tilingData->fdPartialLseOffset = 0;
    tilingData->fdPartialOOffset = 0;
    tilingData->fdWorkspaceEnd = tilingData->workSpaceSize;
}

__attribute__((noinline)) void FillFlashDecodeTiling(FAInferTilingData* tilingData, const FAMetadataArgs* metadataArgs,
                                                     const int32_t* cuSeqlensQ, const int32_t* seqlensK)
{
    for (uint32_t i = 0; i < MAX_FD_CORES; ++i) {
        // Metadata launches use the fixed device block count because the host
        // cannot synchronously read fdActiveCoreNum. Empty schedules keep
        // inactive cores out of the task loop without unsigned -1 casts.
        tilingData->fdDecodeSchedules[i] = {0, 0, 0, 0};
    }
    for (uint32_t i = 0; i < MAX_FD_COMBINE_TASKS; ++i) {
        tilingData->fdCombineSchedules[i] = {-1, -1, -1, 0};
    }

    const uint32_t coreCount = metadataArgs->blockDim;
    const uint32_t activeCoreCapacity = coreCount < MAX_FD_CORES ? coreCount : MAX_FD_CORES;
    const uint32_t combineCapacity =
        coreCount == 0
            ? 0
            : ((3 * coreCount - 1) / 10 < MAX_FD_COMBINE_TASKS ? (3 * coreCount - 1) / 10 : MAX_FD_COMBINE_TASKS);
    tilingData->fdPartialCapacity =
        combineCapacity == 0 || activeCoreCapacity == 0 ? 0 : combineCapacity + activeCoreCapacity - 1;

    FdBaseTask bases[MAX_FD_BASE_TASKS]{};
    uint32_t baseTaskCount = 0;
    const uint32_t groupSize = metadataArgs->numHeadsK == 0 ? 1 : metadataArgs->numHeads / metadataArgs->numHeadsK;
    const uint32_t qBaseTile = tilingData->qBaseTile;

    for (uint32_t batchIndex = 0; batchIndex < metadataArgs->batch; ++batchIndex) {
        uint32_t qSeqlen = metadataArgs->isVarlen
                               ? static_cast<uint32_t>(cuSeqlensQ[batchIndex + 1] - cuSeqlensQ[batchIndex])
                               : metadataArgs->maxQSeqlen;
        uint32_t kvSeqlen = metadataArgs->isVarlenKv
                                ? static_cast<uint32_t>(seqlensK[batchIndex + 1] - seqlensK[batchIndex])
                                : static_cast<uint32_t>(seqlensK[batchIndex]);
        const uint32_t qTileCount = CeilDiv(qSeqlen, qBaseTile);
        const uint32_t kvTileCount = CeilDiv(kvSeqlen, BASE_KV_SIZE);
        const uint32_t qnBlockTile = GetQNBlockTile(qSeqlen, groupSize, metadataArgs->embeddingSizeV);
        const uint32_t qnBlocksPerGroup = CeilDiv(groupSize, qnBlockTile);
        const uint32_t qnTaskCount = qnBlocksPerGroup * metadataArgs->numHeadsK;

        for (uint32_t qTileIndex = 0; qTileIndex < qTileCount; ++qTileIndex) {
            const uint32_t qRows = qTileIndex + 1 == qTileCount ? qSeqlen - qTileIndex * qBaseTile : qBaseTile;
            for (uint32_t qnTask = 0; qnTask < qnTaskCount; ++qnTask) {
                const uint32_t qnBlockIndex = qnTask % qnBlocksPerGroup;
                const uint32_t qnBlockSize = qnBlockTile < groupSize - qnBlockIndex * qnBlockTile
                                                 ? qnBlockTile
                                                 : groupSize - qnBlockIndex * qnBlockTile;
                if (baseTaskCount >= MAX_FD_BASE_TASKS) {
                    DisableFlashDecode(tilingData);
                    return;
                }
                bases[baseTaskCount++] = {kvTileCount, qRows * qnBlockSize};
            }
        }
    }

    tilingData->fdBaseTaskNum = baseTaskCount;
    if (baseTaskCount == 0 || baseTaskCount > combineCapacity || activeCoreCapacity < 2) {
        DisableFlashDecode(tilingData);
        return;
    }

    uint32_t splitCounts[MAX_FD_BASE_TASKS]{};
    uint32_t totalSegments = baseTaskCount;
    for (uint32_t base = 0; base < baseTaskCount; ++base) {
        splitCounts[base] = 1;
    }
    if (metadataArgs->numSplits > 1) {
        totalSegments = 0;
        for (uint32_t base = 0; base < baseTaskCount; ++base) {
            splitCounts[base] =
                metadataArgs->numSplits < bases[base].kvTiles ? metadataArgs->numSplits : bases[base].kvTiles;
            totalSegments += splitCounts[base];
        }
    } else {
        while (totalSegments < activeCoreCapacity) {
            uint32_t bestBase = baseTaskCount;
            uint64_t bestCost = 0;
            for (uint32_t base = 0; base < baseTaskCount; ++base) {
                if (splitCounts[base] >= bases[base].kvTiles) {
                    continue;
                }
                const uint64_t cost =
                    static_cast<uint64_t>(bases[base].rowNum) * bases[base].kvTiles / splitCounts[base];
                if (bestBase == baseTaskCount || cost > bestCost) {
                    bestBase = base;
                    bestCost = cost;
                }
            }
            if (bestBase == baseTaskCount) {
                break;
            }
            ++splitCounts[bestBase];
            ++totalSegments;
        }
    }

    FdCandidate candidates[MAX_FD_CANDIDATES]{};
    uint32_t candidateCount = 0;
    for (uint32_t base = 0; base < baseTaskCount; ++base) {
        for (uint32_t split = 0; split < splitCounts[base]; ++split) {
            if (candidateCount >= MAX_FD_CANDIDATES) {
                DisableFlashDecode(tilingData);
                return;
            }
            const uint32_t begin =
                static_cast<uint32_t>(static_cast<uint64_t>(bases[base].kvTiles) * split / splitCounts[base]);
            const uint32_t end =
                static_cast<uint32_t>(static_cast<uint64_t>(bases[base].kvTiles) * (split + 1) / splitCounts[base]);
            candidates[candidateCount++] = {base, begin, end,
                                            static_cast<uint64_t>(bases[base].rowNum) * (end - begin)};
        }
    }

    const uint32_t activeCores = activeCoreCapacity < candidateCount ? activeCoreCapacity : candidateCount;
    if (activeCores <= baseTaskCount) {
        DisableFlashDecode(tilingData);
        return;
    }

    uint64_t totalCost = 0;
    for (uint32_t i = 0; i < candidateCount; ++i) {
        totalCost += candidates[i].cost;
    }
    uint32_t coreBegin[MAX_FD_CORES]{};
    uint32_t coreEnd[MAX_FD_CORES]{};
    uint32_t candidateBegin = 0;
    uint64_t consumedCost = 0;
    for (uint32_t core = 0; core < activeCores; ++core) {
        coreBegin[core] = candidateBegin;
        const uint32_t coresLeft = activeCores - core;
        const uint32_t maxEnd = candidateCount - (coresLeft - 1);
        uint32_t end = candidateBegin + 1;
        const uint64_t target = totalCost * (core + 1) / activeCores;
        while (end < maxEnd && consumedCost + candidates[end - 1].cost < target) {
            consumedCost += candidates[end - 1].cost;
            ++end;
        }
        consumedCost += candidates[end - 1].cost;
        coreEnd[core] = end;
        candidateBegin = end;
        const FdCandidate& first = candidates[coreBegin[core]];
        const FdCandidate& last = candidates[end - 1];
        tilingData->fdDecodeSchedules[core] = {static_cast<int32_t>(first.baseTask),
                                               static_cast<int32_t>(last.baseTask + 1),
                                               static_cast<int32_t>(first.kvBegin), static_cast<int32_t>(last.kvEnd)};
    }

    uint32_t partialStart = 0;
    uint32_t combineCount = 0;
    for (uint32_t base = 0; base < baseTaskCount; ++base) {
        int32_t firstCore = -1;
        uint32_t partialCount = 0;
        for (uint32_t core = 0; core < activeCores; ++core) {
            const FdDecodeSchedule& schedule = tilingData->fdDecodeSchedules[core];
            if (schedule.baseTaskStart <= static_cast<int32_t>(base) &&
                static_cast<int32_t>(base) < schedule.baseTaskEnd) {
                if (firstCore < 0) {
                    firstCore = static_cast<int32_t>(core);
                }
                ++partialCount;
            }
        }
        if (partialCount > 1) {
            if (combineCount >= MAX_FD_COMBINE_TASKS) {
                DisableFlashDecode(tilingData);
                return;
            }
            tilingData->fdCombineSchedules[combineCount++] = {static_cast<int32_t>(base), firstCore,
                                                              static_cast<int32_t>(partialStart),
                                                              static_cast<int32_t>(partialCount)};
            partialStart += partialCount;
        }
    }

    if (combineCount == 0 || partialStart > tilingData->fdPartialCapacity) {
        DisableFlashDecode(tilingData);
        return;
    }
    tilingData->fdActiveCoreNum = activeCores;
    tilingData->fdCombineTaskNum = combineCount;
    tilingData->fdPartialTaskNum = partialStart;
    tilingData->fdCombineBlockDim = combineCount < coreCount ? combineCount : coreCount;

    uint32_t maxFdRows = 0;
    for (uint32_t base = 0; base < baseTaskCount; ++base) {
        maxFdRows = maxFdRows > bases[base].rowNum ? maxFdRows : bases[base].rowNum;
    }
    tilingData->fdRowCapacity = static_cast<uint32_t>(AlignUp(maxFdRows, 8));
    tilingData->fdLseSubStride = static_cast<uint32_t>(AlignUp((tilingData->fdRowCapacity + 1) / 2, 8));
    tilingData->fdPartialLseOffset = AlignUp(tilingData->workSpaceSize, FD_WORKSPACE_ALIGNMENT);
    const uint64_t partialLseSize =
        static_cast<uint64_t>(tilingData->fdPartialCapacity) * 2 * tilingData->fdLseSubStride * SIZE_OF_32BIT;
    tilingData->fdPartialOOffset = AlignUp(tilingData->fdPartialLseOffset + partialLseSize, FD_WORKSPACE_ALIGNMENT);
    const uint64_t partialOSize = static_cast<uint64_t>(tilingData->fdPartialCapacity) * tilingData->fdRowCapacity *
                                  metadataArgs->embeddingSizeV * SIZE_OF_16BIT;
    tilingData->fdWorkspaceEnd = tilingData->fdPartialOOffset + partialOSize;
    tilingData->workSpaceSize = tilingData->fdWorkspaceEnd;
    tilingData->flashDecodeFlag = 1;
}

} // namespace

__global__ __aicpu__ uint32_t ComputeFAMetadata(void* args)
{
    auto* metadataArgs = reinterpret_cast<FAMetadataArgs*>(args);
    auto* tilingData =
        reinterpret_cast<FAInferTilingData*>(metadataArgs->metaOutAddr + fa_metadata::TilingOffset(false));
    auto* cuSeqlensQ = reinterpret_cast<const int32_t*>(metadataArgs->cuSeqlensQAddr);
    auto* seqlensK = reinterpret_cast<const int32_t*>(metadataArgs->seqlensKAddr);
    auto* tilingBytes = reinterpret_cast<uint8_t*>(tilingData);
    std::memset(tilingData, 0, sizeof(*tilingData));
    tilingData->batch = metadataArgs->batch;
    tilingData->numHeads = metadataArgs->numHeads;
    tilingData->kvHeads = metadataArgs->numHeadsK;
    tilingData->embeddingSize = metadataArgs->embeddingSize;
    tilingData->embeddingSizeV = metadataArgs->embeddingSizeV;
    tilingData->numBlocks = metadataArgs->numBlocks;
    tilingData->blockSize = metadataArgs->pagedKV ? metadataArgs->blockSize : 128;
    tilingData->maxNumBlocksPerBatch = metadataArgs->maxNumBlocksPerBatch;
    tilingData->maskType = metadataArgs->maskType;
    tilingData->scaleValue = metadataArgs->softmaxScale;
    tilingData->windowSizeLeft = metadataArgs->windowSizeLeft;
    tilingData->windowSizeRight = metadataArgs->windowSizeRight;
    tilingData->sparseMode = 0;
    tilingData->cacheLayout = 0;
    tilingData->globalWindowSize = 4;
    tilingData->localWindowSize = 0;
    tilingData->splitMode = metadataArgs->numSplits == 0 ? 0 : (metadataArgs->numSplits == 1 ? 1 : 2);
    tilingData->requestedNumSplits = metadataArgs->numSplits;
    tilingData->qBaseTile = metadataArgs->embeddingSizeV > 128 ? 64 : 128;
    tilingData->kvBaseTile = 128;
    tilingData->qkL1TileM = 128;
    tilingData->qkL1TileN = 256;
    tilingData->qkL1TileKLeft = (metadataArgs->embeddingSize + 15) / 16 * 16;
    tilingData->qkL1TileKRight = 192;
    tilingData->pvL1TileM = 128;
    tilingData->pvL1TileN = (metadataArgs->embeddingSizeV + 15) / 16 * 16;
    tilingData->pvL1TileKLeft = 128;
    tilingData->pvL1TileKRight = 128;
    tilingData->qL1BufNum = 1;
    tilingData->kL1BufNum = 2;
    tilingData->vL1BufNum = 2;
    tilingData->pL1BufNum = 3;
    tilingData->qkOutSize = fa_metadata::Mm1OutSize(metadataArgs->blockDim);
    tilingData->smOnlineOutSize = fa_metadata::SmOnlineOutSize(metadataArgs->blockDim);
    tilingData->pvOutSize = fa_metadata::Mm2OutSize(metadataArgs->blockDim);
    tilingData->UpdateSize = fa_metadata::UpdateOutSize(metadataArgs->blockDim);
    tilingData->workSpaceSize = fa_metadata::WorkSpaceSize(metadataArgs->blockDim);

    uint32_t maxQSeqlen = 0;
    uint32_t maxKvSeqlen = 0;
    uint32_t totalTaskNum = 0;
    uint32_t firstBatchTaskNum = 0;
    const uint32_t groupSize = metadataArgs->numHeadsK == 0 ? 1 : metadataArgs->numHeads / metadataArgs->numHeadsK;
    for (uint32_t batchIndex = 0; batchIndex < metadataArgs->batch; ++batchIndex) {
        const uint32_t qSeqlen = metadataArgs->isVarlen
                                     ? static_cast<uint32_t>(cuSeqlensQ[batchIndex + 1] - cuSeqlensQ[batchIndex])
                                     : metadataArgs->maxQSeqlen;
        const uint32_t kvSeqlen = metadataArgs->isVarlenKv
                                      ? static_cast<uint32_t>(seqlensK[batchIndex + 1] - seqlensK[batchIndex])
                                      : static_cast<uint32_t>(seqlensK[batchIndex]);
        maxQSeqlen = maxQSeqlen > qSeqlen ? maxQSeqlen : qSeqlen;
        maxKvSeqlen = maxKvSeqlen > kvSeqlen ? maxKvSeqlen : kvSeqlen;
        const uint32_t qnBlockTile = GetQNBlockTile(qSeqlen, groupSize, metadataArgs->embeddingSizeV);
        const uint32_t batchTaskNum =
            CeilDiv(groupSize, qnBlockTile) * metadataArgs->numHeadsK * CeilDiv(qSeqlen, tilingData->qBaseTile);
        if (batchIndex == 0) {
            firstBatchTaskNum = batchTaskNum;
        }
        totalTaskNum += batchTaskNum;
    }
    tilingData->maxQSeqlen = maxQSeqlen;
    tilingData->maxKvSeqlen = maxKvSeqlen;
    tilingData->firstBatchTaskNum = firstBatchTaskNum;
    tilingData->totalTaskNum = totalTaskNum;

    const uint32_t groupSizeForFlashDecode =
        metadataArgs->numHeadsK == 0 ? 1 : metadataArgs->numHeads / metadataArgs->numHeadsK;
    const bool isFlashDecodeCandidate = metadataArgs->pagedKV != 0 && metadataArgs->isVarlen != 0 &&
                                        metadataArgs->numSplits != 1 && metadataArgs->maskType != 2 &&
                                        maxQSeqlen <= 16 && maxQSeqlen * groupSizeForFlashDecode <= 128 &&
                                        maxKvSeqlen >= 1024;
    if (isFlashDecodeCandidate) {
        FillFlashDecodeTiling(tilingData, metadataArgs, cuSeqlensQ, seqlensK);
    }
    AscendC::DataStoreBarrier();
    return 0;
}
