#include "aicpu_api.h"
#include "fa_metadata_plan.h"

__global__ __aicpu__ uint32_t ComputeFAMetadata(void* args)
{
    const auto* metadataArgs = reinterpret_cast<const FAMetadataArgs*>(args);
    auto* tilingData =
        reinterpret_cast<FAInferStaticTilingData*>(metadataArgs->metaOutAddr + fa_metadata::TilingOffset(false));
    const auto* cuQ = reinterpret_cast<const int32_t*>(metadataArgs->cuSeqlensQAddr);
    const auto* usedQ = reinterpret_cast<const int32_t*>(metadataArgs->seqlensQAddr);
    const auto* usedKv = reinterpret_cast<const int32_t*>(metadataArgs->seqlensKAddr);
    if (cuQ != nullptr && cuQ[0] != 0) {
        return 1U;
    }
    for (uint32_t b = 0; b < metadataArgs->batch; ++b) {
        const int64_t regionQ = cuQ == nullptr ? metadataArgs->maxQSeqlen : int64_t(cuQ[b + 1]) - cuQ[b];
        const int64_t q = usedQ == nullptr ? regionQ : usedQ[b];
        const int32_t k = usedKv[b];
        if (q < 0 || q > regionQ || q > metadataArgs->maxQSeqlen || k < 0 ||
            static_cast<uint32_t>(k) > metadataArgs->maxKvSeqlen) {
            return 1U;
        }
    }
    fa4_metadata_plan::Fill(metadataArgs, tilingData);
    AscendC::DataStoreBarrier();
    return 0;
}
